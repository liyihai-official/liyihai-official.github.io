---
import { cubing, formatTime } from '@/data/cubing';
import { eventIcons } from '@/data/eventIcons';
const { t, lang = 'en' } = Astro.props;
const c = t.cubing;
const stats = [
  { label: c.competitions, value: cubing.competitions },
  { label: c.years, value: `${cubing.firstYear}–${cubing.lastYear}` },
  { label: c.solves, value: cubing.solves },
];
---
<div class="glass p-6 md:p-8 reveal cubing-card">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
    <div class="flex items-center gap-4">
      <span class="timeline-logo" aria-hidden="true"><img src="/images/logos/wca.webp" alt="" width="48" height="48" loading="lazy" decoding="async" /></span>
      <div>
        <p class="eyebrow">WCA ID</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">{cubing.wcaId}</p>
      </div>
    </div>
    <dl class="flex flex-wrap gap-x-8 gap-y-4 md:gap-x-10">
      {stats.map(s => (
        <div>
          <dt class="text-xs muted">{s.label}</dt>
          <dd class="mt-1 text-lg font-semibold tabular-nums whitespace-nowrap">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <table class="cubing-table mt-8">
    <caption class="sr-only">{c.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{c.event}</th>
        <th scope="col">{c.single}</th>
        <th scope="col">{c.average}</th>
      </tr>
    </thead>
    <tbody>
      {cubing.records.map(r => (
        <tr>
          <th scope="row">
            <span class="cubing-event">
              {eventIcons[r.event] && <svg class="cubing-icon" viewBox="0 0 500 500" fill="currentColor" aria-hidden="true" focusable="false" set:html={eventIcons[r.event]} />}
              {lang === 'zh' ? r.zh : r.en}
            </span>
          </th>
          <td>{formatTime(r.single)}</td>
          <td>{formatTime(r.average)}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex flex-wrap gap-3">
      <a class="btn btn-ghost" href={cubing.wcaUrl} target="_blank" rel="noreferrer noopener"><img class="btn-logo" src="/images/logos/wca.webp" alt="" width="22" height="22" loading="lazy" decoding="async" />{c.wca}<span aria-hidden="true">↗</span></a>
      <a class="btn btn-ghost" href={cubing.cubingUrl} target="_blank" rel="noreferrer noopener"><img class="btn-logo" src="/images/logos/cubing.webp" alt="" width="22" height="22" loading="lazy" decoding="async" />{c.cubingCom}<span aria-hidden="true">↗</span></a>
    </div>
    <p class="text-xs muted">{c.caption} · {c.asOf} {cubing.asOf}</p>
  </div>
</div>
