---
const { lang = 'en' } = Astro.props;
---
<footer class="container-pro mt-8 pb-8">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-5 border-t border-[var(--border)] pt-7 text-xs muted">
    <p>© {new Date().getFullYear()} {lang === 'zh' ? '李艺海' : 'LI Yihai'}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <a class="hover:text-[var(--brand)]" href="mailto:liy35@gmail.com">liy35@gmail.com</a>
      <a class="hover:text-[var(--brand)]" href="https://github.com/liyihai-official" target="_blank" rel="noreferrer noopener">GitHub ↗</a>
      <a class="hover:text-[var(--brand)]" href="https://www.linkedin.com/in/liyihai" target="_blank" rel="noreferrer noopener">LinkedIn ↗</a>
      <a class="hover:text-[var(--brand)]" href="#main-content">{lang === 'zh' ? '回到顶部' : 'Back to top'} ↑</a>
    </div>
  </div>
</footer>
