---
const {
  t,
  ctas = [],
} = Astro.props;
---
<section class="relative overflow-hidden">
  <!-- Parallax decorative layers（保留） -->
  <div id="parallax-1" class="pointer-events-none absolute -top-24 -left-24 w-[40rem] h-[40rem] rounded-full blur-3xl opacity-30"
       style="background: radial-gradient(circle at 30% 30%, rgba(108,92,231,.45), transparent 60%); will-change: transform;"></div>
  <div id="parallax-2" class="pointer-events-none absolute -right-24 -top-10 w-[36rem] h-[36rem] rounded-full blur-3xl opacity-30"
       style="background: radial-gradient(circle at 60% 40%, rgba(85,239,196,.35), transparent 60%); will-change: transform;"></div>
  <div id="parallax-3" class="pointer-events-none absolute bottom-0 left-1/4 w-[28rem] h-[28rem] rounded-full blur-3xl opacity-25"
       style="background: radial-gradient(circle at 50% 50%, rgba(255,118,117,.35), transparent 60%); will-change: transform;"></div>

  <div class="container-pro relative pt-6 pb-10">
    <!-- 用 glass-nav 作为矩形磨砂容器（替代原来的 class="glass ..."） -->
    <div class="glass-nav p-8 md:p-12 reveal text-black dark:text-white">
      <!-- 两栏布局：左文案右头像；移动端上下堆叠 -->
      <div class="grid items-center gap-8 md:grid-cols-[1fr_1.8fr]">
        <!-- 头像区 -->
        <figure class="relative mx-auto md:mx-2 w-36 h-36 md:w-64 md:h-64">
          <img
            src={`${t.avatar}`}
            alt={`${t.name} avatar`}
            class="w-full h-full rounded-full object-cover ring-1 ring-black/10 dark:ring-white/20 shadow-[0_10px_30px_rgba(0,0,0,.25)]"
            loading="lazy"
            decoding="async"
          />
          <!-- 柔和高光：让头像更有“玻璃折射”质感 -->
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 rounded-full mix-blend-screen opacity-60"
            style="background: radial-gradient(120% 120% at 25% 15%, rgba(255,255,255,.55), transparent 55%);"
          ></span>
        </figure>

        <!-- 文案区 -->
        <div>
          <div class="mt-1 flex flex-wrap gap-7">
            <h1 class="mt-2 text-3xl md:text-5xl font-bold leading-tight tracking-tight bg-clip-text dark:text-white text-black bg-gradient-to-r from-brand to-[var(--accent)]">
              {t.name}
            </h1>
            <span
              class="badge mt-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium
                    border bg-black/5 text-black border-black/10
                    dark:bg-white/10 dark:text-white dark:border-white/10
                    shadow-[inset_0_1px_0_rgba(255,255,255,.25)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,.08)]"
              data-magnet
            >
              {t.open_to}
            </span>
          </div>

          <!-- 打字机副标题（保留） -->
          <p class="mt-3 text-xl md:text-2xl text-black/75 dark:text-white/85 min-h-[2.2rem]" id="typed-subtitle" aria-live="polite"></p>

          <!-- 新增：简短自我介绍 -->
          <p class="mt-4 text-base md:text-lg text-black/80 dark:text-white/85 leading-relaxed">
            {`${t.bio}`}
          </p>

          <!-- CTA 按钮 -->
          <div class="mt-7 flex flex-wrap gap-3">
            {ctas.map((c) => (
              <a href={c.href} class={`btn ${c.primary ? 'btn-primary' : 'btn-ghost'}`} data-magnet>{c.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Parallax on scroll（保留）
    const l1 = document.getElementById('parallax-1');
    const l2 = document.getElementById('parallax-2');
    const l3 = document.getElementById('parallax-3');
    const onScroll = ()=> {
      const y = window.scrollY || 0;
      if(l1) l1.style.transform = `translateY(${y * 0.08}px)`;
      if(l2) l2.style.transform = `translateY(${y * 0.12}px)`;
      if(l3) l3.style.transform = `translateY(${y * -0.06}px)`;
    };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });

    // Typewriter
    const el = document.getElementById('typed-subtitle');
    const phrases = [
      "High-Performance Computing",
      "Scientific ML",
      "MPI/OpenMP",
      "Scientific Computing"
    ];
    let p = 0, i = 0, deleting = false;
    const type = ()=>{
      const text = phrases[p];
      if(!el) return;
      if(!deleting){
        i++; el.textContent = text.slice(0, i);
        if(i >= text.length){ deleting = true; setTimeout(type, 1200); return; }
        setTimeout(type, 35 + Math.random()*65);
      } else {
        i--; el.textContent = text.slice(0, i);
        if(i <= 0){ deleting = false; p = (p+1)%phrases.length; setTimeout(type, 220); return; }
        setTimeout(type, 28 + Math.random()*40);
      }
    };
    type();
  </script>
</section>
