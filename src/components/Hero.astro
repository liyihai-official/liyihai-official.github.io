---
const { t, ctas = [] } = Astro.props;
---
<section class="container-pro pt-5 pb-6 md:pt-9 md:pb-10" aria-labelledby="hero-title">
  <div class="glass hero-panel">
    <div class="grid items-center gap-8 md:gap-14 md:grid-cols-[240px_1fr]">
      <figure class="hero-portrait mx-auto">
        <img src={t.avatar} alt={t.name} width="256" height="256" loading="eager" fetchpriority="high" decoding="async" />
      </figure>
      <div>
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 id="hero-title" class="mt-3 text-4xl md:text-6xl font-semibold tracking-tight">{t.name}<span class="text-[var(--brand)]">.</span></h1>
        <p class="mt-4 text-lg md:text-xl font-medium leading-relaxed">{t.tagline}</p>
        <p class="mt-4 text-sm md:text-base muted leading-relaxed max-w-2xl">{t.bio}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          {ctas.map(c => <a href={c.href} download={c.href.endsWith('.pdf') ? true : undefined} class={`btn ${c.primary ? 'btn-primary' : 'btn-ghost'}`}>{c.label}<span aria-hidden="true">{c.primary ? '↓' : '↗'}</span></a>)}
        </div>
        <p class="mt-6 inline-flex items-center gap-2 text-xs muted"><span class="status-dot" aria-hidden="true"></span>{t.open_to}</p>
      </div>
    </div>
  </div>
</section>
