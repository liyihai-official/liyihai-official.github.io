---
import ScrollProgress from './ScrollProgress.astro';
import { otherLang } from '@/i18n';
const { t, lang, alternateHref } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const switchHref = alternateHref ?? Astro.url.pathname.replace(/^\/(en|zh)(?=\/|$)/, `/${otherLang(lang)}`);
const links = [
  { href: `/${lang}/#experience`, label: t.nav.experience },
  { href: `/${lang}/projects/`, label: t.nav.projects },
  { href: `/${lang}/skills/`, label: t.nav.skills },
  { href: `/${lang}/blog/`, label: t.nav.blog },
  { href: `/${lang}/#contact`, label: t.nav.contact },
];
---
<ScrollProgress />
<header class="site-header" id="site-header">
  <div class="container-pro">
    <div class="glass-nav">
      <div class="flex items-center justify-between gap-3 px-3 py-1.5">
        <a href={`/${lang}/`} class="flex items-center gap-3 shrink-0" aria-label={`${t.name} · ${t.ui.home}`}>
          <span class="h-9 w-9 rounded-xl bg-white/80 border border-black/5 flex items-center justify-center"><img src="/icon.png" alt="" width="23" height="23" /></span>
          <span class="font-semibold tracking-tight text-sm">{t.name}</span>
        </a>
        <nav class="hidden md:flex items-center gap-1" aria-label={t.ui.navigation}>
          {links.map(l => <a href={l.href} class="nav-link" aria-current={path === l.href.replace(/\/$/, '') ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <div class="flex items-center gap-2">
          <a href={switchHref} data-language-switch class="nav-control" lang={otherLang(lang)} aria-label={lang === 'en' ? '切换为中文' : 'Switch to English'}>{lang === 'en' ? '中文' : 'EN'}</a>
          <button id="theme-toggle" class="nav-control" aria-label={t.ui.theme} title={t.ui.theme} aria-pressed="false">
            <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
            <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          </button>
          <button id="menu-toggle" class="nav-control md:hidden" aria-label={t.ui.menu} aria-controls="mobile-menu" aria-expanded="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        </div>
      </div>
      <nav id="mobile-menu" hidden class="md:hidden p-3" aria-label={t.ui.navigation}>
        <div class="flex flex-col gap-1">{links.map(l => <a href={l.href} class="nav-link" aria-current={path === l.href.replace(/\/$/, '') ? 'page' : undefined}>{l.label}</a>)}</div>
      </nav>
    </div>
  </div>
</header>
<script>
  const root = document.documentElement;
  const themeButton = document.getElementById('theme-toggle');
  const syncTheme = () => {
    const dark = root.classList.contains('dark');
    themeButton?.setAttribute('aria-pressed', String(dark));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#121119' : '#faf9fc');
  };
  syncTheme();
  themeButton?.addEventListener('click', () => {
    root.classList.toggle('dark');
    try { localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light'); } catch {}
    syncTheme();
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
    let saved;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (saved !== 'dark' && saved !== 'light') { root.classList.toggle('dark', e.matches); syncTheme(); }
  });
  const header = document.getElementById('site-header');
  const menuButton = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    if (!menu) return;
    menu.hidden = !open;
    menuButton?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('menu-open', open);
  };
  menuButton?.addEventListener('click', () => setMenu(menu?.hidden ?? false));
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && menu && !menu.hidden) { setMenu(false); menuButton?.focus(); }
  });
  document.addEventListener('click', e => { if (e.target instanceof Node && !header?.contains(e.target)) setMenu(false); });
  matchMedia('(min-width: 768px)').addEventListener('change', e => { if (e.matches) setMenu(false); });
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  updateHeader();
  addEventListener('scroll', updateHeader, { passive: true });
  const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
  const updateLanguageHash = () => { if (languageLink) languageLink.hash = location.hash; };
  updateLanguageHash();
  addEventListener('hashchange', updateLanguageHash);
</script>
