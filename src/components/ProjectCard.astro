---
const { title, description, tags = [], link, repo } = Astro.props;
---
<a href={link} class="block glass p-6 md:p-8 card-hover group project-card reveal" data-project data-tags={tags.join(',')} target="_blank" rel="noreferrer noopener">
  <div class="project-tilt">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-xl font-bold group-hover:text-black dark:group-hover:text-white">{title}</h3>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="opacity-70 group-hover:opacity-100 transition-opacity"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <p class="mt-3 text-black/70 dark:text-white/70">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((t) => <span class="badge">{t}</span>)}
    </div>
    {repo && <p class="mt-4 text-sm text-black/60 dark:text-white/60">Code: <a href={repo} class="underline hover:text-black dark:hover:text-white">{repo}</a></p>}
  </div>
</a>
