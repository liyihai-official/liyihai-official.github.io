---
const { title, description, tags = [], link, repo, t, heading = 'h3' } = Astro.props;
const Heading = heading;
---
<article class="glass p-6 md:p-8 card-hover project-card reveal" data-project data-tags={JSON.stringify(tags)}>
  <Heading class="text-lg font-semibold tracking-tight">{title}</Heading>
  <p class="mt-3 muted text-sm">{description}</p>
  <div class="mt-5 flex flex-wrap gap-2">{tags.map(tag => <span class="badge">{tag}</span>)}</div>
  <div class="project-actions flex flex-wrap gap-5 text-sm font-medium text-[var(--brand)]">
    {link && <a href={link} target="_blank" rel="noreferrer noopener" aria-label={`${t.ui.visit}: ${title}`} class="hover:underline">{t.ui.visit} <span aria-hidden="true">↗</span></a>}
    {repo && <a href={repo} target="_blank" rel="noreferrer noopener" aria-label={`${t.ui.source}: ${title}`} class="hover:underline">{t.ui.source} <span aria-hidden="true">↗</span></a>}
    {!link && !repo && <span class="muted text-xs font-normal">{t.ui.unavailable}</span>}
  </div>
</article>
