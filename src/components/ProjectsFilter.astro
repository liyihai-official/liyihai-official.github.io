---
const { tags = [] } = Astro.props;
---
<div class="glass p-4 md:p-6 mb-6">
  <div class="flex flex-wrap gap-2" id="tags-filter">
    {tags.map(t => <button class="badge" data-magnet data-tag={t}>{t}</button>)}
    <button class="badge" data-magnet data-tag="__all">All</button>
  </div>
</div>
<script>
  const root = document.getElementById('tags-filter');
  root?.addEventListener('click', (e)=>{
    const btn = e.target.closest('button[data-tag]');
    if(!btn) return;
    const tag = btn.getAttribute('data-tag');
    document.querySelectorAll('[data-project]').forEach((card)=>{
      const tags = (card.getAttribute('data-tags')||'').split(',');
      const show = tag === '__all' || tags.includes(tag);
      card.style.display = show ? '' : 'none';
    });
  });
</script>
