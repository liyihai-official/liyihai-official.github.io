---
const { id, title, subtitle } = Astro.props;
---
<section id={id} class="container-pro py-12 md:py-16">
  <div class="mb-8 md:mb-12 reveal">
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">{title}</h2>
    {subtitle && <p class="text-black/70 dark:text-white/70 mt-2">{subtitle}</p>}
  </div>
  <div class="grid gap-6 md:gap-8">
    <slot />
  </div>
</section>
