---
const { id, title, subtitle, heading = 'h2' } = Astro.props;
const Heading = heading;
---
<section id={id} class="container-pro py-12 md:py-16">
  <div class="mb-8 md:mb-12 reveal">
    <Heading class="section-heading text-2xl md:text-3xl font-semibold tracking-tight">{title}</Heading>
    {subtitle && <p class="muted mt-3 text-sm">{subtitle}</p>}
  </div>
  <div class="grid gap-6 md:gap-8">
    <slot />
  </div>
</section>
