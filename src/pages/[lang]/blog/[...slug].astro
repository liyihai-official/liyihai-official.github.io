export async function getStaticPaths() {
  return []; // 不生成任何博客页面
}

import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { t as getT, validLang } from "@/i18n";
import { getCollection } from 'astro:content';

const { lang, slug } = Astro.params;
const langSafe = validLang(lang) ? lang : 'en';
const t = getT(langSafe);

const all = await getCollection('blog', ({ data }) => data.lang === langSafe);
const entry = all.find((e) => e.slug === slug);
if (!entry) {
  throw new Error("Post not found");
}
const { Content } = await entry.render();
const headings = await entry.getHeadings();
---

<BaseLayout title={`${entry.data.title} — ${t.name}`} lang={langSafe}>
  <Nav t={t} lang={langSafe} />
  <main class="container-pro py-10 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <article class="prose prose-zinc max-w-none dark:prose-invert">
      <h1 class="mb-2">{entry.data.title}</h1>
      <p class="text-sm text-black/60 dark:text-white/60">{new Date(entry.data.date).toDateString()}</p>
      <div class="mt-6">
        <Content />
      </div>
    </article>
    <aside class="hidden lg:block sticky top-20 h-max">
      <div class="glass p-4">
        <h4 class="font-semibold mb-3">On this page</h4>
        <nav id="toc" class="space-y-2 text-sm">
          {headings.filter(h => h.depth <= 3).map(h => (
            <a href={`#${h.slug}`} class="block opacity-80 hover:opacity-100" data-toc={h.slug}>
              {Array(h.depth-1).fill('  ').join('')}{h.text}
            </a>
          ))}
        </nav>
      </div>
      <script>
        const links = Array.from(document.querySelectorAll('#toc [data-toc]'));
        const obs = new IntersectionObserver(entries => {
          entries.forEach(e => {
            if(e.isIntersecting){
              const id = e.target.id;
              links.forEach(a => a.classList.toggle('text-brand', a.getAttribute('data-toc')===id));
            }
          });
        }, { rootMargin: '0px 0px -70% 0px', threshold: 0.1 });
        links.forEach(a => {
          const id = a.getAttribute('data-toc');
          const el = id && document.getElementById(id);
          if(el) obs.observe(el);
        });
      </script>
    </aside>
  </main>
  <Footer lang={langSafe} />
</BaseLayout>
