---
export const getStaticPaths = () => ([
  { params: { lang: 'en' } },
  { params: { lang: 'zh' } }
]);
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import ExperienceItem from "@/components/ExperienceItem.astro";
import Cubing from "@/components/Cubing.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Footer from "@/components/Footer.astro";

import { t as getT, validLang } from "@/i18n";
import { education, experienceGroups } from "@/data/resume";
import { personJsonLd } from "@/data/person";
import { getCollection } from "astro:content";

const { lang } = Astro.params;
const langSafe = validLang(lang) ? lang : 'en';
const t = getT(langSafe);
const projects = (await getCollection('projects', ({ data }) => data.lang === langSafe)).slice(0, 4);
---
<BaseLayout lang={langSafe} jsonLd={personJsonLd(langSafe, new URL(`/${langSafe}/`, Astro.site).href, Astro.site!)}>
  <Nav t={t} lang={langSafe} />
  
  <main id="main-content" tabindex="-1">
  <Hero
    t={t}
    ctas={[
      { href: '/CV.pdf', label: t.ui.download, primary: true },
      { href: `/${lang}/#contact`, label: t.nav.contact, primary: false},
    ]}
  />

  <Section id="education" title={t.sections.education.title} subtitle={t.sections.education.subtitle}>
    <div class="grid gap-4">
      {education(langSafe).map(it => <ExperienceItem {...it} heading="h3" />)}
    </div>
  </Section>

  <Section id="experience" title={t.sections.experience.title} subtitle={t.sections.experience.subtitle}>
    <ExperienceList groups={experienceGroups(langSafe)} />
  </Section>

  <Section id="projects" title={t.sections.projects.title} subtitle={t.sections.projects.subtitle}>
    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {projects.map((p) => <ProjectCard title={p.data.title} description={p.data.summary} tags={p.data.tags} link={p.data.link} repo={p.data.repo} t={t} />)}
    </div>
    <a href={`/${langSafe}/projects/`} class="text-sm text-[var(--brand)] font-medium justify-self-start">{t.ui.viewAll} <span aria-hidden="true">↗</span></a>
  </Section>

  <Section id="cubing" title={t.sections.cubing.title} subtitle={t.sections.cubing.subtitle}>
    <Cubing t={t} lang={langSafe} />
  </Section>

  <Section id="contact" title={t.sections.contact.title} subtitle={t.sections.contact.subtitle}>
    <div class="glass p-6 md:p-8 reveal">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <h3 class="text-xl md:text-2xl font-semibold tracking-tight">{t.ui.contactTitle}</h3>
          <p class="mt-2 muted text-sm md:text-base">{t.ui.contactBody}</p>
        </div>
        <a href="mailto:yihai.li@temple.edu" class="btn btn-primary">
          {t.sections.contact.cta}
        </a>
      </div>
    </div>
  </Section>

  </main>
  <Footer lang={langSafe} />
</BaseLayout>
