---
export const getStaticPaths = () => ([
  { params: { lang: 'en' } },
  { params: { lang: 'zh' } }
]);
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Footer from "@/components/Footer.astro";

import { t as getT, validLang } from "@/i18n";
import { experienceGroups } from "@/data/resume";
import { getCollection } from "astro:content";

const { lang } = Astro.params;
const langSafe = validLang(lang) ? lang : 'en';
const t = getT(langSafe);
const projects = (await getCollection('projects', ({ data }) => data.lang === langSafe)).slice(0, 4);
---
<BaseLayout title={`${t.name} — ${t.tagline}`} description={t.bio} lang={langSafe}>
  <Nav t={t} lang={langSafe} />
  
  <main id="main-content" tabindex="-1">
  <Hero
    t={t}
    ctas={[
      { href: '/CV.pdf', label: t.ui.download, primary: true },
      { href: `/${lang}/#contact`, label: t.nav.contact, primary: false},
    ]}
  />

  <Section id="experience" title={t.sections.experience.title} subtitle={t.sections.experience.subtitle}>
    <ExperienceList groups={experienceGroups(langSafe)} />
  </Section>

  <Section id="projects" title={t.sections.projects.title} subtitle={t.sections.projects.subtitle}>
    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {projects.map((p) => <ProjectCard title={p.data.title} description={p.data.summary} tags={p.data.tags} link={p.data.link} repo={p.data.repo} t={t} />)}
    </div>
    <a href={`/${langSafe}/projects/`} class="text-sm text-[var(--brand)] font-medium justify-self-start">{t.ui.viewAll} <span aria-hidden="true">↗</span></a>
  </Section>

  <Section id="contact" title={t.sections.contact.title} subtitle={t.sections.contact.subtitle}>
    <div class="glass p-8 md:p-10 reveal">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <h3 class="text-2xl font-bold">{t.ui.contactTitle}</h3>
          <p class="text-black/70 dark:text-white/70 mt-2">{t.ui.contactBody}</p>
        </div>
        <a href="mailto:liy35@gmail.com" class="btn btn-primary">
          {t.sections.contact.cta}
        </a>
      </div>
    </div>
  </Section>

  </main>
  <Footer lang={langSafe} />
</BaseLayout>
