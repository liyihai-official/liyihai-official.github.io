---
export const getStaticPaths = () => ([
  { params: { lang: 'en' } },
  { params: { lang: 'zh' } }
]);
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectsFilter from "@/components/ProjectsFilter.astro";
import Footer from "@/components/Footer.astro";
import { t as getT, validLang } from "@/i18n";
import { getCollection } from 'astro:content';

const { lang } = Astro.params;
const langSafe = validLang(lang) ? lang : 'en';
const t = getT(langSafe);
const items = await getCollection('projects', ({ data }) => data.lang === langSafe);
const tagSet = Array.from(new Set(items.flatMap(i => (i.data.tags||[]))));
---
<BaseLayout title={`${t.name} — Projects`} lang={langSafe}>
  <Nav t={t} lang={langSafe} />
  <Section id="projects" title={t.sections.projects.title} subtitle={t.sections.projects.subtitle}>
    <ProjectsFilter tags={tagSet} />
    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {items.map((p) => <ProjectCard title={p.data.title} description={p.data.summary} tags={p.data.tags} link={p.data.link || '#'} repo={p.data.repo} />)}
    </div>
  </Section>
  <Footer lang={langSafe} />
</BaseLayout>
