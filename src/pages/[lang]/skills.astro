---
export const getStaticPaths = () => ([
  { params: { lang: 'en' } },
  { params: { lang: 'zh' } }
]);
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Section from "@/components/Section.astro";
import Footer from "@/components/Footer.astro";
import { t as getT, validLang } from "@/i18n";

const { lang } = Astro.params;
const langSafe = validLang(lang) ? lang : 'en';
const t = getT(langSafe);
const skillList = [
  ["C++/CMake", 90],
  ["MPI/OpenMP", 88],
  ["CUDA", 75],
  ["PyTorch/LibTorch", 84],
  ["Numerical Methods", 86],
  ["Slurm/HDF5", 80]
];
---
<BaseLayout title={`${t.name} — Skills`} lang={langSafe}>
  <Nav t={t} lang={langSafe} />
  <Section id="skills" title={t.sections.skills.title} subtitle={t.sections.skills.subtitle}>
    <div class="grid md:grid-cols-2 gap-6">
      {skillList.map(([label, pct]) => (
        <div class="glass p-5 reveal">
          <div class="flex items-center justify-between mb-2">
            <span class="font-semibold">{label}</span>
            <span class="text-white/70">{pct}%</span>
          </div>
          <div class="skill-meter"><span style={`transform:scaleX(${Number(pct)/100})`}></span></div>
        </div>
      ))}
    </div>
  </Section>
  <Footer lang={langSafe} />
</BaseLayout>
