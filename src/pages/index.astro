---
const defaultLang = 'en';
const target = `/${defaultLang}/`;
---
<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
  </head>
  <body></body>
</html>
