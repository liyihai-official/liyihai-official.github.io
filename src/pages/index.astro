---
const target = '/en/';
Astro.redirect(target);
const defaultLang = 'en'; // 换成你的默认语言，比如 'zh'
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=/${defaultLang}/`} />
    <title>Redirecting…</title>
    <script>location.replace('/' + {defaultLang} + '/');</script>
  </head>
  <body></body>
</html>
